  "mcp_connections": [
    {
      "id": "github-mcp",
      "name": "GitHub MCP (read-only)",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env_keys": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "allowed_tools": [
        "get_repository",
        "get_file_contents",
        "list_commits",
        "get_commit",
        "list_branches",
        "get_branch",
        "list_issues",
        "get_issue",
        "get_issue_comments",
        "search_issues",
        "list_pull_requests",
        "get_pull_request",
        "get_pull_request_files",
        "get_pull_request_comments",
        "get_pull_request_reviews",
        "search_code",
        "search_repositories"
      ],
      "trust_level": "verified",
      "notes": "read-only。トークンは .env.local の GITHUB_PERSONAL_ACCESS_TOKEN から読む"
    }
  ],
  "rules": {
    "allow_external_experts": true,
    "allow_world_link": true,
    "require_user_consent_before_external_mcp": true,
    "store_conversation_logs": true
  },
